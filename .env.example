# Copy to .env and fill in for your machine.
#
# This service imports PoleScan's pipeline directly (see
# polescan_pipeline.py) -- it must run using PoleScan's OWN Python
# environment (the Anaconda environment with torch, transformers, arcgis,
# numpy, pymupdf, and pillow already installed; see PoleScan's INSTALL.txt),
# with fastapi/uvicorn/python-multipart additionally installed into it.
# There is no longer a separate "PoleScan's environment" vs. "this
# service's environment" -- they're the same one.

# --- PoleScan pipeline ---
POLESCAN_PROJECT_DIR=C:\Users\kschultz\PycharmProject\PoleScan
UPLOAD_DIR=

# --- ArcGIS Portal ---
# pro: use the active portal signed into ArcGIS Pro.
# profile: use a saved ArcGIS API for Python profile (set ARCGIS_PROFILE).
ARCGIS_AUTH_MODE=pro
ARCGIS_PROFILE=

POLES_LAYER_ITEM_ID=579b19fe7d694112b4995d59f5572936
WORK_AREAS_LAYER_ITEM_ID=4bf5a6e4fd234f6d92d81a576ba9a8c3
POLE_COORDINATE_WKID=3734
WORK_AREA_BUFFER_FEET=50

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
