# Copy to .env and fill in for your machine.

# --- Pole discovery (app/discovery/) ---
UPLOAD_DIR=./uploads

# Authoritative pole reference database (SQLite). These match the real
# table/columns in the city's electric reference database.
POLE_DB_PATH=C:\Users\kschultz\PycharmProject\Joint-Use-Permits-REST\pole_reference.sqlite
POLE_TABLE=SupportStructure
POLE_ID_COLUMN=FacilityID
POLE_SOURCE_ID_COLUMN=OBJECTID
POLE_X_COLUMN=X
POLE_Y_COLUMN=Y

# Local Qwen3-VL model directory (used for pages the native-text pass
# can't match). Must contain config.json, preprocessor_config.json,
# tokenizer_config.json, and its .safetensors weights.
QWEN_MODEL_DIR=C:\PoleScan\models\Qwen3-VL-8B-Instruct
MINIMUM_CANDIDATE_CONFIDENCE=0.80
MAX_PDF_MB=500

# --- ArcGIS Portal ---
# pro: use the active portal signed into ArcGIS Pro.
# profile: use a saved ArcGIS API for Python profile (set ARCGIS_PROFILE).
ARCGIS_AUTH_MODE=pro
ARCGIS_PROFILE=

# Portal item ID of the JointUsePermits hosted feature service (holds BOTH
# related layers AND several reference tables). Run Joint-Use-Permits/
# scripts/create_layers.py -- it prints this ID and the indices below.
SERVICE_ITEM_ID=
WORK_AREAS_LAYER_INDEX=0
POLES_LAYER_INDEX=1
# Index within the service's tables (not layers) -- create_layers.py /
# add_permit_number_sequence.py print the right value. See
# permit_creation.py's generate_permit_number.
PERMIT_NUMBER_SEQUENCE_TABLE_INDEX=0

POLE_COORDINATE_WKID=3734
WORK_AREA_BUFFER_FEET=50

# Poles created below this confidence get status "Needs Review" instead
# of "Approved" (see Joint-Use-Permits/scripts/add_pole_review_fields.py).
POLE_REVIEW_CONFIDENCE_THRESHOLD=0.85

# --- Email (app/email_service.py) ---
# Used only by POST /notify-message, called by the internal
# Joint-Use-Permits widget after a city reply. Blank SMTP_HOST disables
# sending -- that endpoint still succeeds, just without the email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@example.gov

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
