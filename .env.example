# Copy to .env and fill in for your machine.

# --- Pole discovery (app/discovery/) ---
UPLOAD_DIR=./uploads

# Authoritative pole reference database (SQLite). These match the real
# table/columns in the city's electric reference database.
POLE_DB_PATH=C:\Users\kschultz\PycharmProject\Joint-Use-Permits-REST\pole_reference.sqlite
POLE_TABLE=SupportStructure
POLE_ID_COLUMN=FacilityID
POLE_SOURCE_ID_COLUMN=OBJECTID
POLE_X_COLUMN=X
POLE_Y_COLUMN=Y

# Local Qwen3-VL model directory (used for pages the native-text pass
# can't match). Must contain config.json, preprocessor_config.json,
# tokenizer_config.json, and its .safetensors weights.
QWEN_MODEL_DIR=C:\JointUsePermits\models\qwen3-vl
MINIMUM_CANDIDATE_CONFIDENCE=0.80
MAX_PDF_MB=500

# --- ArcGIS Portal ---
# pro: use the active portal signed into ArcGIS Pro.
# profile: use a saved ArcGIS API for Python profile (set ARCGIS_PROFILE).
ARCGIS_AUTH_MODE=pro
ARCGIS_PROFILE=

POLES_LAYER_ITEM_ID=579b19fe7d694112b4995d59f5572936
WORK_AREAS_LAYER_ITEM_ID=4bf5a6e4fd234f6d92d81a576ba9a8c3
POLE_COORDINATE_WKID=3734
WORK_AREA_BUFFER_FEET=50

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
